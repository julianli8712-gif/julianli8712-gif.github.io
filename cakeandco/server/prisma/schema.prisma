generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cake {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(255)
  nameEn             String?  @map("name_en") @db.VarChar(255)
  category           String   @db.VarChar(50)
  stockMode          String   @map("stock_mode") @db.VarChar(20)
  description        String?  @db.Text
  descriptionEn      String?  @map("description_en") @db.Text
  story              String?  @db.Text
  tastingNote        String?  @map("tasting_note") @db.Text
  imageUrls         String[] @map("image_urls")
  sizes             String[]
  prices            String[]
  pairingDrink       String?  @map("pairing_drink") @db.VarChar(255)
  salesTip           String?  @map("sales_tip") @db.Text
  status             String   @default("ACTIVE") @db.VarChar(20)
  stockQty           Int      @default(0) @map("stock_qty")
  lowStockThreshold  Int      @default(3) @map("low_stock_threshold")
  isChefPick         Boolean  @default(false) @map("is_chef_pick")
  leadTimeHours      Int      @default(24) @map("lead_time_hours")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tags        CakeTagRelation[]
  reservations Reservation[]

  @@map("cakes")
}

model CakeTag {
  id     String  @id @default(uuid()) @db.Uuid
  type   String  @db.VarChar(50)
  name   String  @db.VarChar(100)
  nameEn String? @map("name_en") @db.VarChar(100)

  cakes CakeTagRelation[]

  @@map("cake_tags")
}

model CakeTagRelation {
  // NOTE: DB columns are historically swapped:
  //   cake_id stores CakeTag.id, tag_id stores Cake.id
  //   So cake field points to CakeTag, tag field points to Cake
  cakeId String  @map("cake_id") @db.Uuid
  tagId  String  @map("tag_id") @db.Uuid
  cake   CakeTag @relation(fields: [cakeId], references: [id], onDelete: Cascade)
  tag    Cake    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cakeId, tagId])
  @@map("cake_tag_relations")
}

model Reservation {
  id           String   @id @default(uuid()) @db.Uuid
  cakeId       String?  @map("cake_id") @db.Uuid
  cakeName     String   @map("cake_name") @db.VarChar(255)
  size         String?  @db.VarChar(20)
  quantity     Int      @default(1)
  totalPrice   Decimal? @map("total_price") @db.Decimal(10, 2)
  accessories String[]
  guestName    String   @map("guest_name") @db.VarChar(100)
  guestPhone   String   @map("guest_phone") @db.VarChar(20)
  pickupMethod String   @default("PICKUP") @map("pickup_method") @db.VarChar(20)
  pickupTime   DateTime @map("pickup_time") @db.Timestamptz()
  message      String?  @db.Text
  aiPrompt             String?  @map("ai_prompt") @db.Text
  aiImageUrl           String?  @map("ai_image_url") @db.VarChar(500)
  specialRequirements  String?  @map("special_requirements") @db.Text
  status               String   @default("PENDING") @db.VarChar(20)
  staffNote    String?  @map("staff_note") @db.Text
  isAiCustom   Boolean  @default(false) @map("is_ai_custom")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cake Cake? @relation(fields: [cakeId], references: [id])

  @@map("reservations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("STAFF") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("staff_accounts")
}

model Recommendation {
  id        String   @id @default(uuid()) @db.Uuid
  direction String   @db.VarChar(50)
  sourceTags String[] @map("source_tags")
  results   Json
  isOffline Boolean  @default(false) @map("is_offline")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("recommendations")
}

// ─── Bar: Digital Sommelier ───────────────────────────────────────

model BarProfile {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  nameEn      String?  @map("name_en") @db.VarChar(255)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("bar_profiles")
}

model Drink {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  nameEn      String?  @map("name_en") @db.VarChar(255)
  type        String   @db.VarChar(50)       // WINE | COCKTAIL | SPIRIT | BEER | SAKE | OTHER
  subtype     String?  @db.VarChar(50)       // RED | WHITE | ROSE | SPARKLING | FORTIFIED | GIN | WHISKY | etc.
  region      String?  @db.VarChar(100)
  producer    String?  @db.VarChar(255)
  vintage     String?  @db.VarChar(20)
  abv         Decimal? @db.Decimal(5, 2)
  bottlePrice Decimal? @map("bottle_price") @db.Decimal(10, 2)
  glassPrice  Decimal? @map("glass_price") @db.Decimal(10, 2)
  description String?  @db.Text
  tastingNote String?  @map("tasting_note") @db.Text
  story       String?  @db.Text
  flavorTags  String[] @map("flavor_tags")
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  foodPairings FoodPairing[]

  @@map("drinks")
}

model FoodItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  nameEn      String?  @map("name_en") @db.VarChar(255)
  category    String?  @db.VarChar(50)       // SMALL_PLATE | CHEESE | DESSERT | CHARCUTERIE | SNACK | MAIN
  description String?  @db.Text
  flavorNote  String?  @map("flavor_note") @db.Text
  story       String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  drinkPairings FoodPairing[]

  @@map("food_items")
}

model FoodPairing {
  id        String   @id @default(uuid()) @db.Uuid
  drinkId   String   @map("drink_id") @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  mode      String   @db.VarChar(30)  // CLASSIC | BOLD | STORY
  reason    String?  @db.Text
  story     String?  @db.Text
  score     Int      @default(5)
  drink     Drink    @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  food      FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("food_pairings")
}

model BarExport {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(30)  // MENU_INSERT | TABLE_CARD | STORY_CARD
  title       String   @db.VarChar(255)
  htmlContent String   @map("html_content") @db.Text
  pdfUrl      String?  @map("pdf_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("bar_exports")
}
